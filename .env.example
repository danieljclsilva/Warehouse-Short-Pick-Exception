# Development: PostgreSQL connection to a local database.
# Production: Railway PostgreSQL service reference.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/short_pick_exception

# Public HTTPS origin in production, without a trailing slash.
APP_URL=http://localhost:3000

# Legacy authentication policy names. Runtime login lockout settings are managed
# by the versioned database configuration; these variables are not read.
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15

# Set only while bootstrapping the first administrator, then remove from .env.
# ADMIN_DISPLAY_NAME=Admin User
# ADMIN_IDENTIFIER=spx-admin
# ADMIN_PIN=replace-with-a-unique-numeric-pin

# Emergency operator-only recovery for an existing active Admin. Set these
# temporarily, run npm run recover:admin, then remove them immediately.
# ADMIN_RECOVERY_IDENTIFIER=spx-admin
# ADMIN_RECOVERY_PIN=replace-with-a-unique-numeric-pin
# ADMIN_RECOVERY_CONFIRM=RESET_ADMIN_PIN_AND_REVOKE_SESSIONS

# Optional Web Push configuration. Keep the private key secret and stable across deploys.
# Generate a VAPID pair with `npx web-push generate-vapid-keys`.
# PUSH_PUBLIC_KEY=
# PUSH_PRIVATE_KEY=
# PUSH_SUBJECT=mailto:ops@example.com
# Persistent private S3-compatible object storage (required in production).
# Use the Railway bucket endpoint and credentials; do not use a public bucket.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Set true for providers that require path-style S3 requests (usually false on Railway).
STORAGE_FORCE_PATH_STYLE=false

# Optional company name printed in generated analytics PDF reports.
# WAREHOUSE_COMPANY_NAME=North Warehouse
