# Development: PostgreSQL connection to a local database.
# Production: Railway PostgreSQL service reference.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/short_pick_exception

# Public HTTPS origin in production, without a trailing slash.
APP_URL=http://localhost:3000

# Authentication policy (sessions intentionally have no TTL).
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Set only while bootstrapping the first administrator, then remove from .env.
# ADMIN_DISPLAY_NAME=Admin User
# ADMIN_IDENTIFIER=spx-admin
# ADMIN_PIN=replace-with-a-unique-numeric-pin

# Emergency operator-only recovery for an existing active Admin. Set these
# temporarily, run npm run recover:admin, then remove them immediately.
# ADMIN_RECOVERY_IDENTIFIER=spx-admin
# ADMIN_RECOVERY_PIN=replace-with-a-unique-numeric-pin
# ADMIN_RECOVERY_CONFIRM=RESET_ADMIN_PIN_AND_REVOKE_SESSIONS

# Future phases: configure when Web Push and persistent file storage are implemented.
# PUSH_PUBLIC_KEY=
# PUSH_PRIVATE_KEY=
# PUSH_SUBJECT=
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
